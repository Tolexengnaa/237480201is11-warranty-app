<mxfile host="app.diagrams.net" type="device"><diagram id="d1" name="Kiến trúc – L2"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L1" value="&lt;b&gt;1. LỚP GIAO DIỆN (Web UI)&lt;/b&gt; — hiển thị 3 màn hình, kiểm tra định dạng nhập (SĐT 10 số, IMEI 15 số), gọi API, hiển thị thông báo lỗi. &lt;i&gt;Không chứa quy tắc nghiệp vụ.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="820" height="120" as="geometry"/></mxCell><mxCell id="L2" value="&lt;b&gt;2. LỚP API (Controller)&lt;/b&gt; — nhận yêu cầu HTTP, xác thực phiên đăng nhập, lấy &lt;i&gt;người gọi&lt;/i&gt;, chuyển JSON ↔ đối tượng, trả mã lỗi 400 / 403 / 409." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="820" height="120" as="geometry"/></mxCell><mxCell id="L3" value="&lt;b&gt;3. LỚP NGHIỆP VỤ (Service)&lt;/b&gt; — chứa toàn bộ quy tắc BR1–BR6, kiểm tra vai trò người gọi (NFR4), mở / đóng giao dịch CSDL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="820" height="210" as="geometry"/></mxCell><mxCell id="L4" value="&lt;b&gt;4. LỚP TRUY CẬP DỮ LIỆU (Repository)&lt;/b&gt; — đọc / ghi CSDL bằng SQL tham số hoá; lọc và phân trang ngay trong CSDL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="820" height="110" as="geometry"/></mxCell><mxCell id="v2" value="M1 Tạo phiếu bảo hành" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="85" y="70" width="230" height="50" as="geometry"/></mxCell><mxCell id="v3" value="M2 Danh sách phiếu bảo hành" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="335" y="70" width="230" height="50" as="geometry"/></mxCell><mxCell id="v4" value="M3 Chi tiết phiếu bảo hành" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="585" y="70" width="230" height="50" as="geometry"/></mxCell><mxCell id="v5" value="TicketController&lt;br&gt;&lt;font style='font-size:10px'&gt;/api/tickets, /api/issue-categories, /api/technicians&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="85" y="240" width="230" height="50" as="geometry"/></mxCell><mxCell id="v6" value="CustomerController&lt;br&gt;&lt;font style='font-size:10px'&gt;/api/customers, /api/devices&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="335" y="240" width="230" height="50" as="geometry"/></mxCell><mxCell id="v7" value="AuthMiddleware&lt;br&gt;&lt;font style='font-size:10px'&gt;/api/auth/login · xác thực, lấy người gọi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="585" y="240" width="230" height="50" as="geometry"/></mxCell><mxCell id="ts" value="TicketService&lt;br&gt;&lt;font style='font-size:10px'&gt;FR1 · BR1, BR2, BR3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="85" y="410" width="230" height="50" as="geometry"/></mxCell><mxCell id="cs" value="ClassifyService&lt;br&gt;&lt;font style='font-size:10px'&gt;FR2 · BR4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="335" y="410" width="230" height="50" as="geometry"/></mxCell><mxCell id="as" value="AssignService&lt;br&gt;&lt;font style='font-size:10px'&gt;FR3 · BR5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="585" y="410" width="230" height="50" as="geometry"/></mxCell><mxCell id="ss" value="StatusService&lt;br&gt;&lt;font style='font-size:10px'&gt;FR5 · BR6 · nơi DUY NHẤT đổi trạng thái + ghi lịch sử&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f5fa8;strokeWidth=2;fontSize=12;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="500" width="300" height="54" as="geometry"/></mxCell><mxCell id="e8" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.2;fontSize=10;labelBackgroundColor=none;" edge="1" parent="1" source="ts" target="ss"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.2;fontSize=10;labelBackgroundColor=none;" edge="1" parent="1" source="cs" target="ss"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.2;fontSize=10;labelBackgroundColor=none;" edge="1" parent="1" source="as" target="ss"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v11" value="CustomerRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="668" width="128" height="46" as="geometry"/></mxCell><mxCell id="v12" value="DeviceRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="185" y="668" width="128" height="46" as="geometry"/></mxCell><mxCell id="v13" value="TicketRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320" y="668" width="128" height="46" as="geometry"/></mxCell><mxCell id="v14" value="IssueCategoryRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="455" y="668" width="128" height="46" as="geometry"/></mxCell><mxCell id="v15" value="StaffRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="668" width="128" height="46" as="geometry"/></mxCell><mxCell id="v16" value="StatusLogRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="725" y="668" width="128" height="46" as="geometry"/></mxCell><mxCell id="DB" value="&lt;b&gt;CSDL PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;customer · device · ticket · issue_category&lt;br&gt;staff · ticket_status_log&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="790" width="400" height="110" as="geometry"/></mxCell><mxCell id="e17" value="HTTPS · REST / JSON · kèm token phiên đăng nhập" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="Gọi hàm trực tiếp (cùng tiến trình) · truyền DTO + người gọi" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="Gọi hàm qua interface Repository · trong giao dịch" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="SQL tham số hoá qua connection pool" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L4" target="DB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v21" value="&lt;b&gt;CHÚ THÍCH KÝ HIỆU&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="20" width="310" height="300" as="geometry"/></mxCell><mxCell id="v22" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="905" y="55" width="40" height="26" as="geometry"/></mxCell><mxCell id="v23" value="Lớp (layer) – ghi trách nhiệm ở tiêu đề" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="955" y="53" width="240" height="30" as="geometry"/></mxCell><mxCell id="v24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="905" y="95" width="40" height="26" as="geometry"/></mxCell><mxCell id="v25" value="Thành phần (màn hình, controller, service, repository)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="955" y="90" width="240" height="36" as="geometry"/></mxCell><mxCell id="v26" value="" style="shape=cylinder3;html=1;size=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="910" y="135" width="30" height="36" as="geometry"/></mxCell><mxCell id="v27" value="Cơ sở dữ liệu" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="955" y="138" width="240" height="30" as="geometry"/></mxCell><mxCell id="v28" value="" style="text;" vertex="1" parent="1"><mxGeometry x="905" y="195" width="1" height="1" as="geometry"/></mxCell><mxCell id="v29" value="" style="text;" vertex="1" parent="1"><mxGeometry x="945" y="195" width="1" height="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.8;" edge="1" parent="1" source="v28" target="v29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v31" value="Lớp trên gọi lớp liền dưới (chỉ gọi xuống, không gọi vượt lớp); nhãn = cách trao đổi" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="955" y="180" width="240" height="44" as="geometry"/></mxCell><mxCell id="v32" value="" style="rounded=0;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="905" y="240" width="40" height="26" as="geometry"/></mxCell><mxCell id="v33" value="Ngoài phạm vi BT1 / luồng L2" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="955" y="238" width="240" height="30" as="geometry"/></mxCell><mxCell id="v34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f5fa8;strokeWidth=2;fontSize=12;arcSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="905" y="282" width="40" height="22" as="geometry"/></mxCell><mxCell id="v35" value="Thành phần then chốt cho NFR5" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="955" y="278" width="240" height="30" as="geometry"/></mxCell><mxCell id="v36" value="&lt;b&gt;NGOÀI PHẠM VI&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="890" y="360" width="310" height="265" as="geometry"/></mxCell><mxCell id="v37" value="Cổng gửi SMS cho khách hàng&lt;br&gt;(FR6 – WON'T)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#555555;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="395" width="270" height="46" as="geometry"/></mxCell><mxCell id="v38" value="Luồng sửa chữa, linh kiện, trả máy&lt;br&gt;(sau trạng thái &lt;i&gt;Đang xử lý&lt;/i&gt;)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#555555;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="455" width="270" height="4