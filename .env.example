# database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcrm
DB_USER=smartcrm
DB_PASSWORD=smartcrm

# app
APP_PORT=3000
# Khoá ký token đăng nhập. Để TRỐNG thì hệ thống tự sinh khoá ngẫu nhiên mỗi lần khởi động.
# Muốn giữ phiên đăng nhập qua các lần khởi động: tạo khoá ≥ 32 ký tự bằng
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
TOKEN_EXPIRES_IN=8h
